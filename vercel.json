{
  "version": 2,
  "buildCommand": "./build.sh",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'Skipping default install'",
  "github": {
    "silent": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
