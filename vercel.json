{
  "version": 2,
  "buildCommand": "./build.sh",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'Skipping default install'",
  "github": {
    "silent": false
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon|icon|manifest|robots).*(svg|json|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
